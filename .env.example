# SQLite database file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Extra hostnames (comma separated, with port if not 80/443) allowed to reach the
# API besides localhost. Needed only when serving on a LAN, e.g. "tracker.lan:3000".
ALLOWED_HOSTS=""

# Optional: model used by the Decompose button. Any OpenAI-compatible
# chat-completions endpoint works. Leave LLM_BASE_URL empty to use built-in templates.
#   Ollama:    LLM_BASE_URL="http://localhost:11434/v1"  LLM_MODEL="llama3.1"  (no key)
#   Gemini:    LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   Anthropic: LLM_BASE_URL="https://api.anthropic.com/v1"
#   OpenAI:    LLM_BASE_URL="https://api.openai.com/v1"
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Optional: an iCalendar (.ics) feed whose events block out working time.
# Used by Settings -> "Refresh from configured calendar". Treat private feed URLs as secrets.
ICS_URL=""
